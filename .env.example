# IP do servidor na rede local
SERVER_IP=192.168.0.XXX

# Portas do Backend (API) e Frontend (Producao: 8060, Dev: 8070)
PORT=3060
FRONTEND_PORT=8060
DEV_FRONTEND_PORT=8070

# Variaveis para o Vite (Frontend)
VITE_SERVER_IP=192.168.0.XXX
VITE_PORT=8060
VITE_API_PORT=3060
VITE_API_URL=http://192.168.0.XXX:3060

# Pasta raiz dos jogos
GAME_FOLDER=C:\Caminho\Dos\Jogos

# Chave da API SteamGridDB
STEAMGRIDDB_KEY=

# Integracao Steam Web API (Conquistas e Estatisticas)
STEAM_API_KEY=
STEAM_USER_ID=

# Supabase Cloud Sync (Opcional)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_EMAIL=
SUPABASE_PASSWORD=

# Token de seguranca da API (gerado automaticamente se vazio)
API_TOKEN=
VITE_API_TOKEN=
