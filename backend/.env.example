# Porta do servidor
PORT=3000


# Pasta onde os jogos serão buscados
# Informe a pasta raiz da sua biblioteca de jogos

GAME_FOLDER=C:\Caminho\Dos\Jogos


# IP da máquina que está rodando o servidor
# Usado apenas para exibir o endereço no console

SERVER_IP=192.168.0.XXX

#Chave do SteamGridDB para leitura de capas dos jogos
STEAMGRIDDB_KEY=